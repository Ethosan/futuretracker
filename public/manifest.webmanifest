{
  "name": "Trade Journal",
  "short_name": "Journal",
  "description": "A futures trading journal. Log each trade with what you felt and what you did wrong, then see where the money goes. Saves to your own Google Drive or this device.",
  "id": "/",
  "start_url": "/#log-trade",
  "scope": "/",
  "display": "standalone",
  "display_override": ["standalone", "minimal-ui"],
  "orientation": "any",
  "background_color": "#141414",
  "theme_color": "#141414",
  "categories": ["finance", "productivity"],
  "launch_handler": { "client_mode": "focus-existing" },
  "icons": [
    { "src": "/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "/icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" },
    { "src": "/icon.svg", "sizes": "any", "type": "image/svg+xml" }
  ],
  "shortcuts": [
    { "name": "Log a trade", "short_name": "Log", "url": "/#log-trade", "icons": [{ "src": "/icon-192.png", "sizes": "192x192" }] },
    { "name": "Trade log", "short_name": "Trades", "url": "/#trade-log", "icons": [{ "src": "/icon-192.png", "sizes": "192x192" }] },
    { "name": "Stats", "short_name": "Stats", "url": "/#stats", "icons": [{ "src": "/icon-192.png", "sizes": "192x192" }] }
  ],
  "screenshots": [
    { "src": "/screenshots/phone-stats.webp", "sizes": "780x1688", "type": "image/webp", "form_factor": "narrow", "label": "Stats: expectancy, profit factor and drawdown (demo data)" },
    { "src": "/screenshots/phone-heatmap.webp", "sizes": "780x1688", "type": "image/webp", "form_factor": "narrow", "label": "Heatmap of daily P&L (demo data)" },
    { "src": "/screenshots/desktop-stats.webp", "sizes": "1440x900", "type": "image/webp", "form_factor": "wide", "label": "Stats on a computer (demo data)" }
  ]
}
